# Salin file ini menjadi .env lalu isi nilainya.

# "roboflow" = model jadi lewat internet (Jalan A)
# "lokal"    = model hasil latihan sendiri (Jalan B)
MODE_MODEL=roboflow

# --- Jalan A: Roboflow ---
ROBOFLOW_API_KEY=isi_api_key_roboflow_anda
# Ganti dengan model yang paling akurat setelah Anda coba beberapa.
ROBOFLOW_MODEL_ID=accessibility_detection/1

# --- Jalan B: model lokal ---
MODEL_LOKAL=models/kursi_roda.pt

# Nama kelas yang dianggap kursi roda (huruf kecil, pisah koma).
# Cek nama kelas model Anda di halaman Roboflow-nya.
KELAS_TARGET=wheelchair,wheelchair-users,wheelchair user,person in wheelchair

# Kepekaan deteksi
AMBANG_KEYAKINAN=0.5
FRAME_BERTURUT=3
JEDA_ANTAR_TUGAS_DETIK=60
DETEKSI_TIAP_DETIK=1.0

# Ketahanan kirim: bila Firestore gagal (internet putus), tugas dicoba ulang
# sebanyak PERCOBAAN_KIRIM kali dengan jeda bertambah (2s, 4s, ...).
# Kegagalan tidak menghentikan loop deteksi.
PERCOBAAN_KIRIM=3
JEDA_COBA_LAGI_DETIK=2.0

# Identitas kamera
LOKASI_KAMERA=Stasiun Halim - Pintu Masuk Utara
ID_KAMERA=halim-utara-01

# --- Firebase ---
FIREBASE_KEY=firebase-key.json
KOLEKSI_FIRESTORE=permintaan_pendampingan
